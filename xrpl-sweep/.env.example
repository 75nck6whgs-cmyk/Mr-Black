# Copy to .env and fill in. Never commit .env.

# wss://s.altnet.rippletest.net:51233 for Testnet
# wss://xrplcluster.com for Mainnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# Secret seed of the RECEIVING account. This process needs it to sign sweeps.
RECEIVING_SEED=

# Address of the MAIN (treasury) account. Only the address is needed here —
# this process never holds its key.
MAIN_ACCOUNT_ADDRESS=

# XRP kept behind in the receiving account on every sweep, on top of the
# network reserve, as a safety buffer. Adjust once you know real traffic.
SWEEP_RESERVE_BUFFER_XRP=2
