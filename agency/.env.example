# === REQUIRED ===
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Google Maps (Scout) ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# === D-ID (Filmer) ===
DID_API_KEY=your_did_api_key_base64encoded

# === Twilio (Pitcher — SMS + WhatsApp) ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Email (Pitcher) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# === Agency Identity ===
AGENCY_NAME=NobleWeb Agency
AGENCY_EMAIL=hello@youragency.com
AGENCY_PHONE=+1234567890
CALENDLY_URL=https://calendly.com/yourusername

# === Mobile Approval App ===
MOBILE_APP_SECRET=change-this-to-a-random-secret
